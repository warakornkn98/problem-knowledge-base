# ─────────────────────────────────────────────────────────────
# Problem Knowledge Base — environment configuration
# Copy to .env and adjust for your machine:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# --- PostgreSQL -------------------------------------------------
POSTGRES_USER=pkb
POSTGRES_PASSWORD=pkb_secret
POSTGRES_DB=pkb
POSTGRES_PORT=5432

# --- Backend --------------------------------------------------
# When running via docker-compose the host is the service name "postgres".
# For running the Go binary directly on your machine use "localhost".
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable

APP_ENV=development
APP_PORT=8080
# Comma separated list, or * for any origin (dev only)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Auth ----------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=72

# Seeded admin account (cmd/seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin1234

# --- Frontend ----------------------------------------------
# Base URL the browser uses to reach the API.
# With the bundled nginx reverse proxy this stays as /api.
VITE_API_BASE_URL=/api
# Host port for the web UI. Change it if 3000 is already taken
# (Docker Desktop itself listens on 3000 on some setups).
FRONTEND_PORT=3000
